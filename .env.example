# ---------------------------------------------------------------------------
# Configurazione del bot anagrafe.
# Copia questo file in «.env» e riempi i valori. Il file .env non va committato.
# ---------------------------------------------------------------------------

# OBBLIGATORIO — token del bot, te lo dà @BotFather su Telegram.
TOKEN_CITIZENS_BOT=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OBBLIGATORIO — ID Telegram numerico dell'utente root.
# È l'unico che può aggiungere e rimuovere amministratori. Per scoprire il tuo
# ID puoi scrivere a @userinfobot.
ROOT_ADMIN_ID=123456789

# FACOLTATIVO — canale su cui registrare ogni modifica al registro.
# ID numerico (es. -1001234567890) oppure @nomecanale se il canale è pubblico.
# Il bot deve essere amministratore del canale. Se lo lasci vuoto, il log su
# canale è semplicemente disattivato.
LOG_CHANNEL_ID=

# FACOLTATIVO — percorso del database SQLite. Default: ./registro.db
ANAGRAFE_DB_PATH=

# FACOLTATIVO — percorso del file con gli ID degli amministratori.
# Default: ./admins.txt (un ID per riga, «#» per i commenti).
ANAGRAFE_ADMINS_PATH=
